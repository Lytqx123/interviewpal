# InterviewPal 阶段四：豆包实时语音链路本地配置
# 复制本文件为 .env.voice.local 并填写；.env.voice.local 已被 gitignore，不会入库。
# 配置后浏览器页面无需再填凭据；若服务端未配置，页面也可临时填写（仅本机手测）。

# 必填：火山引擎控制台 → 语音技术 → 实时对话（豆包端到端实时语音大模型）
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=

# 以下均可选
# DOUBAO_APP_KEY=PlgvMymc7f3tQnJ6
# DOUBAO_RESOURCE_ID=volc.speech.dialog
# DOUBAO_MODEL=1.2.1.1
# DOUBAO_BOT_NAME=面试官
# DOUBAO_SYSTEM_ROLE=你是一名专业、温和的模拟面试官……
# DOUBAO_SPEAKING_STYLE=口语自然，像真人面试官一样说话……

# 联调模式：1 = 启动本地 Mock 上游，不需要真实凭据
# VOICE_MOCK=1
# 服务端口，默认 8780
# VOICE_PORT=8780
# 1 = 只允许服务端凭据，禁止页面表单传凭据
# VOICE_REQUIRE_ENV=1
